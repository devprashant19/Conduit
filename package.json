{
  "name": "conduit",
  "version": "1.0.0",
  "private": true,
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n tsup,daemon,web,vite -c gray,magenta,cyan,green \"tsup --watch\" \"node --watch dist/daemon/daemon.js\" \"node --watch dist/server.js\" \"vite\"",
    "dev:server": "node --watch dist/server.js",
    "dev:client": "vite",
    "dev:desktop": "npm run build:server && electron dist/electron/main.mjs",
    "build": "npm run typecheck && npm run clean && tsup && vite build",
    "build:server": "tsc --noEmit -p tsconfig.json && tsup",
    "build:client": "tsc --noEmit -p client/tsconfig.json && vite build",
    "build:desktop": "npm run build && electron-builder",
    "daemon": "node dist/daemon/daemon.js",
    "start": "node dist/server.js",
    "start:all": "concurrently -n daemon,web \"npm run daemon\" \"npm run start\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "dev:daemon": "node --watch dist/daemon/daemon.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --no-warnings scripts/test-gates.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "browser-check": "node scripts/browser-check.mjs --deep"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1124.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@strands-agents/sdk": "^1.16.0",
    "chokidar": "^5.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "marked": "^18.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.2.0-beta.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.1",
    "dompurify": "^3.4.14",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
