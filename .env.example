# Conduit configuration — copy to `.env` and fill in what you use.
# Everything is optional for local use.
#
# Conduit reads BOTH ./.env (next to the server) and ~/.conduit/.env; the first
# to define a key wins, and a real environment variable beats both. The desktop
# app runs from its install directory and has no repo, so put desktop settings in
# ~/.conduit/.env. `GET /api/health` lists the files it actually read.

# --- Web server ---------------------------------------------------------
# PORT=3200
# HOST=0.0.0.0             # bind address; use 127.0.0.1 to keep it local-only
# Password-protect the UI + API (HTTP Basic). REQUIRED before exposing the
# port beyond your own machine. Format: user:password
# CONDUIT_AUTH=admin:change-me

# --- Daemon -------------------------------------------------------------
# CONDUIT_DAEMON_PORT=3210   # loopback only, never exposed

# --- Supervisor ---------------------------------------------------------
# Which backend classifies agent output:
#   auto      (default) Bedrock first, Anthropic if Bedrock has no credentials
#   anthropic Anthropic Messages API only
#   bedrock   Amazon Bedrock only
# SUPERVISOR_PROVIDER=anthropic
# Turn the Supervisor off entirely (no model calls at all):
# CONDUIT_SUPERVISOR=off

# Anthropic path.
# Preferred: a real API key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# With no API key, Conduit falls back to the Claude Code OAuth token in
# ~/.claude/.credentials.json. That is Claude Code's own credential — it
# expires (Claude Code refreshes it) and a subscription may not grant every
# model, so prefer an API key for anything long-lived.
#
# Model: leave unset to try claude-opus-5, then claude-sonnet-5, then
# claude-haiku-4-5, keeping the first that answers. Pin one to skip the
# ladder — claude-haiku-4-5 is the cheapest and is usually the one a
# subscription token is allowed to use for this high-volume classifier.
# ANTHROPIC_MODEL_ID=claude-haiku-4-5

# Bedrock path. Region with Claude access on Bedrock.
AWS_REGION=us-east-1
# Leave the keys empty on EC2 with an IAM instance role (recommended).
# Locally, either set these or configure ~/.aws/credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must match the model id allowed by your IAM policy.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- The Keeper (Command panel orchestrator) -----------------------------
# Which CLI runs it: `codex` or `claude`. Unset means prefer codex, then fall
# back to claude — so a Claude Code login alone is enough.
# CONDUIT_KEEPER_ENGINE=claude

# --- Agent CLIs ---------------------------------------------------------
# The `gpt` and `nemotron` agent types run through `aider`, which reads these.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Voice (optional STT/TTS providers; the browser engine needs no key) --
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
