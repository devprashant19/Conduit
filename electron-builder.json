{
  "appId": "com.conduit.desktop",
  "productName": "Conduit",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "linux": {
    "category": "Development",
    "target": ["AppImage", "deb"]
  },
  "win": {
    "target": ["nsis", "zip"]
  }
}
