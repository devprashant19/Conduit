{
  "appId": "com.conduit.desktop",
  "productName": "Conduit",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "dist-desktop",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["zip"]
  },
  "linux": {
    "category": "Development",
    "target": ["AppImage", "deb"]
  },
  "win": {
    "target": ["nsis", "zip"]
  }
}
